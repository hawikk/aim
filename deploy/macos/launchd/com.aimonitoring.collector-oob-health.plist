<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AIM-743 / AIM-639: OOB host health independent of agent user process. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aimonitoring.collector-oob-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/opt/aim-collector/aim-collector-oob-health.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>Nice</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/var/log/aim-collector-oob-health.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/aim-collector-oob-health.log</string>
</dict>
</plist>
