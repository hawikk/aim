# — Pin file for prebuilt control-plane images (copy → images.pin.env).
#
# Source of tags/digests (pick one):
#   1. GitHub Actions → release-images.yml run summary table (preferred)
#   2. GHCR package UI for each ghcr.io/hawikk/aim-* image
#   3. `crane digest ghcr.io/hawikk/aim-api:<tag>` (or docker buildx imagetools)
#
# There is NO floating `latest`. release-images publishes only:
#   - main-<shortsha>  on push to main / workflow_dispatch
#   - the git tag name on push of v* tags
#
# Copy this file to deploy/compose/images.pin.env (gitignored if you put
# secrets nearby; pins themselves are not secret) and source it before
# install-pilot / compose:
#
#   set -a; . deploy/compose/images.pin.env; set +a
#   ./scripts/install-pilot.sh --pull
#
# Supply-chain preference: pin digests (@sha256:…) not movable tags.

AIM_IMAGE_REGISTRY=ghcr.io/hawikk

# --- Tag mode (simpler; tag may be re-pointed only if a human force-pushes) ---
# Example from a main push that built commit 498275d3:
# AIM_IMAGE_TAG=main-498275d

# --- Digest mode (recommended for enterprise pilots) -------------------------
# When AIM_*_IMAGE is set, it overrides registry+tag for that service.
# Uncomment and fill after resolving digests from the release-images summary:
#
# AIM_INGEST_IMAGE=ghcr.io/hawikk/aim-ingest@sha256:REPLACE_ME
# AIM_API_IMAGE=ghcr.io/hawikk/aim-api@sha256:REPLACE_ME
# AIM_GUARDRAIL_IMAGE=ghcr.io/hawikk/aim-guardrail@sha256:REPLACE_ME
# AIM_IDENTITY_SYNC_IMAGE=ghcr.io/hawikk/aim-identity-sync@sha256:REPLACE_ME
#
# Optional pillars (only if you drop docker-compose.pilot.yml or enable profiles):
# AIM_GATEHOUSE_IMAGE=ghcr.io/hawikk/aim-gatehouse@sha256:REPLACE_ME
# AIM_SENTINEL_IMAGE=ghcr.io/hawikk/aim-sentinel@sha256:REPLACE_ME
# AIM_HYGIENE_IMAGE=ghcr.io/hawikk/aim-hygiene@sha256:REPLACE_ME

# pull_policy for app services when using the pull override (always|missing|never)
# AIM_PULL_POLICY=always
