# --- Local stack (docker compose) ---
# Copy to .env to override. Defaults below work out of the box.
# .env is gitignored — never put real secrets in this file either; it ships to the repo as documentation.

# --- which interface published ports bind to ---
# Both default to 127.0.0.1. A compose `ports:` entry with no interface binds
# 0.0.0.0 — every network the host is on — and Docker's DNAT rules sit ahead of
# the INPUT chain, so a host firewall will not save you. Set either to empty and
# it still falls back to loopback; you have to name an address to widen anything.
#
# The app surfaces: ingest, dashboard/API, gatehouse. Set this to 0.0.0.0 (or a
# specific LAN address) when collectors on other machines must reach ingest.
# AIM_BIND_ADDR=127.0.0.1
#
# Postgres + MinIO. Deliberately a SEPARATE knob, so widening the app surfaces
# for a pilot does not also publish the telemetry database. Publishing these at
# all is a local-dev convenience (psql, the MinIO console) — services reach each
# other over the compose network and never use the host port.
# AIM_DATASTORE_BIND_ADDR=127.0.0.1

# Postgres
POSTGRES_USER=aim
POSTGRES_PASSWORD=localdev-only-not-a-secret
POSTGRES_DB=aim
POSTGRES_PORT=5432

# MinIO (S3-compatible object store)
# Ingest archives every accepted raw batch here as NDJSON (see
# docs/deployment/raw-batch-archival.md). Compose wires MINIO_ROOT_USER/PASSWORD
# through to ingest as OBJECT_STORE_ACCESS_KEY/SECRET_KEY.
MINIO_ROOT_USER=aim-local
MINIO_ROOT_PASSWORD=localdev-only-not-a-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=aim-telemetry-local

# API service
API_PORT=8080

# Pipeline liveness alert: GET /api/pipeline/liveness reports
# `status: "idle"` when ingest has accepted NO events for longer than this many
# seconds WHILE at least one non-revoked device is enrolled (a stack with zero
# collectors is expected to be quiet, so it reports `no_collectors`, never an
# alert). The dashboard header pill and any alert path read this endpoint.
# Idle is measured on events.received_at (server accept time), not client ts.
# Default 7200 (2h). See docs/deployment/pipeline-liveness.md.
# PIPELINE_IDLE_THRESHOLD_SECONDS=7200

# identity-sync: directory sync + identity resolution. The compose
# stack runs it with the dev fixture directory (services/identity-sync/fixtures)
# and points ingest at it via IDENTITY_RESOLVE_URL, so team attribution works
# out of the box. Internal only — no host port is published.
# HMAC key for pseudonyms (dev default is fine locally; secret manager in prod):
# IDENTITY_SYNC_PSEUDONYM_SECRET=
# Caller authentication for /reveal + POST /service-identities: the
# caller proves identity with a bearer JWT verified by identity-sync. HS256
# shared secret for in-network/dev callers (compose sets a localdev default;
# secret manager in prod), or point at the IdP JWKS in prod instead:
# IDENTITY_SYNC_JWT_HS256_SECRET=
# IDENTITY_SYNC_JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# IDENTITY_SYNC_JWT_ISSUER=
# IDENTITY_SYNC_JWT_AUDIENCE=
# Domain used to expand bare OS usernames to emails (must match the fixture /
# directory domain):
# IDENTITY_SYNC_PRIMARY_EMAIL_DOMAIN=example.com
# auto session revoke on directory deprovision (opt-in). Point at the
# platform API and a service-token bearer whose name is listed in
# AIM_SESSION_REVOKE_SERVICES on the API:
# IDENTITY_SYNC_AIM_API_URL=http://api:8080
# IDENTITY_SYNC_SESSION_REVOKE_TOKEN=

# Guardrail evaluator: seconds between evaluate-db polls. Idempotent,
# so lower = fresher findings, higher = less DB load. Default 15s.
GUARDRAIL_POLL_INTERVAL=15

# --- retention enforcement (enforced-by-default) ---
# The ingest service purges Postgres on a schedule, applies an object-store
# expiry lifecycle to the raw/ batch prefix, and personal mode prunes its local
# SQLite store. Windows are per data class; the invariant audit >= findings >=
# events is enforced (a violating or unparseable config fails closed — the
# purge is skipped and logged, nothing is deleted). Defaults below ship as-is.
# RETENTION_EVENTS_DAYS=90       # raw usage telemetry (events + raw/ objects)
# RETENTION_FINDINGS_DAYS=365    # guardrail findings (kept longer)
# RETENTION_AUDIT_DAYS=730       # the purge audit trail itself
# RETENTION_DRY_RUN=false        # true = report what would be deleted, delete nothing
# RETENTION_INTERVAL_HOURS=24    # how often the purge runs; 0 disables the scheduler
# RETENTION_BATCH_SIZE=5000      # max rows per DELETE (bounded batches, no long locks)

# Path to the guardrail policy directory served by GET /api/guardrail/rules
#. Default: <repo>/policies/guardrail/v1; the api Docker image sets
# it to the baked-in copy. Point it at the same files the engine loads.
# GUARDRAIL_POLICY_PATH=policies/guardrail/v1

# --- guardrail LLM-judge + GenAI telemetry (off by default) ---
# The guardrail service's LLM-judge call site (`guardrail llm-judge`) reports
# GenAI spans (provider/model/tokens/status/latency — never prompt text) to
# the ingest OTLP receiver. To enable locally: add a dedicated per-app token
# to INGEST_TOKENS (compose default is dev-token-change-me), then set:
# INGEST_TOKENS=dev-token-change-me,<guardrail-app-token>
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080   # http://ingest:8080 inside compose
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <guardrail-app-token>
# AIM_OTEL_SERVICE_NAME=guardrail

# --- first-party vendor admin telemetry (optional, degrade-not-fail) ---
# Read-only org/enterprise scopes only. NEVER commit real values.
# Missing tokens mark the feed dark; ingest keeps running.
# COPILOT_METRICS_TOKEN=
# COPILOT_METRICS_ORG=
# COPILOT_METRICS_ENTERPRISE=
# CURSOR_ADMIN_API_KEY=
# VENDOR_ADMIN_POLL_INTERVAL_S=3600
# LLM provider for the judge (any OpenAI-compatible endpoint; for a keyless
# local run use the stub: python services/guardrail/demo/mock_llm.py):
# AIM_LLM_BASE_URL=http://127.0.0.1:9100
# AIM_LLM_API_KEY=
# AIM_LLM_MODEL=aim-judge-v1

# --- guardrail alert delivery (off by default) ---
# Newly inserted findings are forwarded out of Postgres to a SIEM; every
# outcome is recorded in the finding_deliveries table.
# Generic webhook: one HTTPS POST per batch of new findings, JSON body,
# HMAC-SHA256 signature header (X-AIM-Signature: sha256=<hex>) over the raw
# body, keyed by ALERT_WEBHOOK_SECRET — works with any SIEM/chat/SOAR before
# Sentinel is wired. Both values required to enable.
# ALERT_WEBHOOK_URL=https://siem.examplecorp.com/aim/ingest
# ALERT_WEBHOOK_SECRET=
# Minimum finding severity forwarded to the webhook (low|medium|high|critical;
# default low = everything). Per-rule severity routing: the finding carries
# the severity of the rule that fired it.
# ALERT_WEBHOOK_MIN_SEVERITY=low

# --- Google Chat company channel (off by default) ---
# Incoming-webhook URL for the company Google Chat space. The URL itself is
# the secret (space key + token live in the path/query) — never enter it in
# the Rules UI. Enable the destination from Rules (or set
# settings.alerts.google_chat.enabled in alerts.yaml); the engine fails
# closed if enabled without this env var. Card payload is metadata-only
# (severity, rule, tool, truncated pseudonym, deep link via AIM_BASE_URL).
# ALERT_GOOGLE_CHAT_WEBHOOK_URL=
# Minimum finding severity forwarded (low|medium|high|critical; default high).
# ALERT_GOOGLE_CHAT_MIN_SEVERITY=high

# --- optional Slack destination (OFF by default — SOC opt-in) ---
# Research ranked Slack/email destinations as "only if the security team
# asks." Leave ALERT_SLACK_ENABLED unset until SOC requests it. With the
# flag off the engine ignores ALERT_SLACK_WEBHOOK_URL entirely and the
# Rules UI hides the Slack card. See docs/security/slack-alert-destination.md.
# ALERT_SLACK_ENABLED=0
# Incoming-webhook URL is the secret (token lives in the path) — never enter
# it in the Rules UI. Enable the destination from Rules only after the flag
# is on (or set settings.alerts.slack.enabled in alerts.yaml).
# ALERT_SLACK_WEBHOOK_URL=
# Minimum finding severity forwarded (low|medium|high|critical; default high).
# ALERT_SLACK_MIN_SEVERITY=high


# --- PagerDuty Events API v2 (on-call / escalation stage) ---
# Routing key is the secret — never enter it in the Rules UI. Enable via
# settings.alerts.pagerduty.enabled (or env alone). Pair with
# settings.alerts.escalation_policies for Slack → PagerDuty timers.
# See docs/security/escalation-policies.md.
# ALERT_PAGERDUTY_ROUTING_KEY=
# Minimum severity for env-path registration (default critical).
# ALERT_PAGERDUTY_MIN_SEVERITY=critical
# Optional PD payload.source (default ai-monitoring).
# ALERT_PAGERDUTY_SOURCE=ai-monitoring
# --- email alert destination (off by default) ---
# SMTP delivery for SOC mailbox routes. Secrets (host/from/user/password)
# stay env-managed and are never written to alerts.yaml or returned by the API.
# Recipients can also be set via the Rules UI (non-secret).
#
# ALERT_EMAIL_SMTP_HOST=smtp.examplecorp.com
# ALERT_EMAIL_SMTP_PORT=587
# ALERT_EMAIL_SMTP_USER=
# ALERT_EMAIL_SMTP_PASSWORD=
# ALERT_EMAIL_FROM=aim-alerts@examplecorp.com
# STARTTLS by default on 587; set SSL=1 for implicit TLS (465).
# ALERT_EMAIL_SMTP_TLS=1
# ALERT_EMAIL_SMTP_SSL=0
# Optional default recipients when policy has none:
# ALERT_EMAIL_TO=soc@examplecorp.com,oncall@examplecorp.com
# ALERT_EMAIL_MIN_SEVERITY=high

# --- first-class SIEM export (off by default) ---
# Splunk HEC reference integration: OCSF Detection Finding (class 2004) payload,
# at-least-once via the finding_deliveries sweeper with dead-letter at 8 attempts.
# Both URL and token required to enable. Identity mapping is NOT available via
# env — only via policy settings.alerts.splunk.identity_map (pseudonym -> identity).
# SPLUNK_HEC_URL=https://splunk.examplecorp.com:8088
# SPLUNK_HEC_TOKEN=
# SPLUNK_HEC_SOURCETYPE=aim:guardrail:ocsf:detection_finding
# SPLUNK_HEC_INDEX=
# Syslog/CEF fallback (RFC 5424 + CEF MSG) for SIEMs without HEC/OCSF intake:
# SYSLOG_CEF_HOST=siem.examplecorp.com
# SYSLOG_CEF_PORT=514
# SYSLOG_CEF_PROTOCOL=udp
# SYSLOG_CEF_TLS=false

# Pseudonymization salt shared with the endpoint collectors. The
# guardrail engine needs it to match event.repo_ref against the restricted
# repo list in policies/guardrail/v1/core.yaml. MUST equal the salt deployed
# to collectors (managed config / Intune); a mismatch silently disables
# restricted-repo matching. Leave empty only if the rule should stay inert.
AIM_HASH_SALT=

# Dashboard (apps/api)
DASHBOARD_PORT=8081
# --- Auth: in-app OIDC SSO, or zero-config personal mode ---
# With NO AIM_OIDC_* set the API runs in personal/standalone mode: every
# request is a local admin (single-user/personal use). Set
# AIM_AUTH_DEV=1 to add /auth/dev/login role-switch endpoints for local UI
# work (built-in dev secret — localhost only, never in pilot/prod).
# AIM_AUTH_DEV=1
#
# Pilot / shared environments: set AIM_REQUIRE_SSO=1 so the
# API refuses to boot without complete OIDC credentials and refuses AIM_AUTH_DEV.
# Helm values-standard.yaml sets this automatically.
# AIM_REQUIRE_SSO=1
#
# SSO mode is active when issuer + client id + client secret are all set.
# Partial OIDC (any of the three without the other two) fails closed at boot.
# Register a "web" OIDC app at your IdP with redirect URI
# <AIM_BASE_URL>/auth/callback, then set:
# AIM_OIDC_ISSUER=https://accounts.google.com
# AIM_OIDC_CLIENT_ID=
# AIM_OIDC_CLIENT_SECRET=
# Public base URL of the dashboard (sets the default redirect URI and the
# Secure cookie flag when https):
# AIM_BASE_URL=https://aim.examplecorp.com
# AIM_OIDC_REDIRECT_URI=https://aim.examplecorp.com/auth/callback
# AIM_OIDC_SCOPES=openid profile email
# Claim in the ID token carrying group membership (default: groups)
# AIM_OIDC_GROUPS_CLAIM=groups
# optional OIDC claim names copied into session ABAC attributes (CSV).
# Empty = only derived attrs (teams from groups, email, role). Pure RBAC needs none.
# AIM_OIDC_ATTR_CLAIMS=department,cost_center,teams
#
# --- Multi-IdP concurrent / single-IdP switch -------------------
# Prefer AIM_OIDC_PROVIDERS over legacy AIM_OIDC_ISSUER when more than one
# corporate IdP must issue dashboard sessions. All IdPs share the same
# redirect URI. Docs: docs/deployment/multi-idp-sso.md
# Concurrent:
# AIM_OIDC_PROVIDERS=google,entra,okta
# Single-IdP switch (redeploy to change):
# AIM_OIDC_PROVIDERS=okta
# Google (issuer defaults to https://accounts.google.com):
# AIM_OIDC_GOOGLE_CLIENT_ID=
# AIM_OIDC_GOOGLE_CLIENT_SECRET=
# Entra (tenant issuer required):
# AIM_OIDC_ENTRA_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# AIM_OIDC_ENTRA_CLIENT_ID=
# AIM_OIDC_ENTRA_CLIENT_SECRET=
# Okta (org issuer required):
# AIM_OIDC_OKTA_ISSUER=https://{org}.okta.com
# AIM_OIDC_OKTA_CLIENT_ID=
# AIM_OIDC_OKTA_CLIENT_SECRET=
# AIM_OIDC_OKTA_SCOPES=openid profile email groups
# Group -> role mapping (comma-separated; precedence admin > analyst
# > auditor > viewer; no match = authenticated with zero access, fail closed).
# Full matrix: docs/identity-production-group-mapping.md
# AIM_ROLE_GROUPS_ADMIN=ai-monitoring-security
# AIM_ROLE_GROUPS_ANALYST=ai-monitoring-analysts
# AIM_ROLE_GROUPS_AUDITOR=ai-monitoring-auditors
# AIM_ROLE_GROUPS_VIEWER=ai-monitoring-viewers
# Reveal grant (de-pseudonymization) — a separate capability, not a role,
# and NOT bundled into admin:
# AIM_REVEAL_GROUPS=ai-monitoring-revealers
# REQUIRED in SSO mode (min 32 chars) — signs the stateless session cookie:
#   openssl rand -base64 32
# AIM_SESSION_SECRET=
# Session lifetime in hours (default 8). High-assurance tenants may lower
# this (e.g. 1–2h). Mid-TTL leaver force-deny is POST /api/admin/sessions/revoke
# (session watermark), not secret rotation.
# AIM_SESSION_TTL_HOURS=8
# Comma-separated service-token *names* allowed to call session revoke without
# holding admin (identity-sync deprovision automation). Empty = humans
# only. Pair with a token entry in AIM_SERVICE_TOKENS_FILE (role analyst/auditor
# is fine — admin is still forbidden for service tokens).
# AIM_SESSION_REVOKE_SERVICES=identity-sync
# (session watermark), not secret rotation.
# AIM_SESSION_TTL_HOURS=8
#
# --- SCIM 2.0 provisioning ---
# When set (min 16 chars), enables /scim/v2/* for IdP User/Group push
# (Okta / Entra / Google). Bearer auth only — not the OIDC session cookie.
#   openssl rand -base64 32
# AIM_SCIM_BEARER_TOKEN=
# Soft mode (default): only SCIM-known users with active=false are denied
# mid-session. Enforce mode: only active SCIM users may hold an SSO session.
# AIM_SCIM_ENFORCE=0
# Optional JSON map of SCIM group displayName → AIM role:
# AIM_SCIM_GROUP_ROLE_MAP={"Security Admins":"admin","Readers":"viewer"}
# Runbook: docs/security/scim-provisioning.md
#
# --- JIT provisioning on first SSO login ---
# When SCIM is configured, first OIDC/SAML login upserts the user into the
# SCIM directory (never reactivates active=false). Default on; set 0 for
# SCIM push-only. AIM-side SLA default 1000ms (identity.jit_sla_breach).
# AIM_JIT_PROVISIONING=1
# AIM_JIT_SLA_MS=1000
# Runbook: docs/security/jit-provisioning-sla.md

# --- Sentinel alerting + immutable audit trail ---
# Microsoft Sentinel / Log Analytics Data Collector API (leave empty = forwarding disabled)
# Also consumed by the guardrail evaluator's Python forwarder: new
# findings are pushed to Sentinel when both values are set.
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
# Custom log table name (appears in Sentinel as <logType>_CL); default AIGuardrailFinding
# SENTINEL_LOG_TYPE=AIGuardrailFinding
# Full URL override for the Data Collector endpoint (sovereign clouds / tests).
# SENTINEL_ENDPOINT=
# Base URL prepended to taxonomy runbook slugs in each finding
RUNBOOK_BASE_URL=https://wiki.corp/runbooks/
# Immutable audit trail (both required to enable; single writer per path)
AUDIT_LOG_PATH=./data/audit.jsonl
AUDIT_HMAC_KEY=

# --- gatehouse, PR-time security review (pillar 3) ---
# The GitHub App's numeric id, from its settings page.
GATEHOUSE_APP_ID=
# The HMAC secret configured on the App's webhook. REQUIRED: `gatehouse serve`
# exits rather than accept unauthenticated webhooks, so leaving this empty
# makes the service inert instead of dangerously open.
#   openssl rand -hex 32
GATEHOUSE_WEBHOOK_SECRET=
# The App private key, mounted read-only into the container. A file rather than
# an env var: env vars appear in `docker inspect` and are inherited by every
# scanner subprocess gatehouse runs over untrusted repository code.
GATEHOUSE_SECRETS_DIR=./deploy/secrets
# Severity at which a finding FAILS the PR check. Security owns this policy;
# `high` is the shipped proposal (critical + high block, medium/low report).
GATEHOUSE_FAIL_ON=high
# Webhook listen port on the host.
GATEHOUSE_PORT=8090
# — dogfood merge-audit PATs (NEVER commit values).
# Prefer separate fine-grained PATs (github_pat_*). Interim gho_*/ghp_* work but
# are over-broad; cutover + rollback: docs/security/gatehouse-pat-cutover.md
# Verify (prints no secrets): gatehouse check-tokens --require-fine-grained
# GATEHOUSE_GITHUB_TOKEN=   # read: Contents/Checks/PRs/Issues/Metadata Read
# GATEHOUSE_REVERT_TOKEN=   # write: Contents+PRs RW, Metadata Read (separate PAT)

# repo coverage ledger (gated vs dark) on the Coverage screen.
# aim-api fetches gatehouse GET /coverage/repos server-side. Compose defaults
# GATEHOUSE_COVERAGE_URL to http://gatehouse:8090/coverage/repos.
# GATEHOUSE_COVERAGE_URL=http://gatehouse:8090/coverage/repos
# Optional shared token if you put gatehouse behind auth later.
# GATEHOUSE_COVERAGE_TOKEN=
# How long a gated repo can go quiet before it alarms as runner_offline (7d).
# GATEHOUSE_COVERAGE_STALE_SECONDS=604800
# Optional full-org inventory (one owner/repo per line) so selective App
# installs surface not_onboarded repos instead of hiding them.
# GATEHOUSE_ORG_INVENTORY_FILE=/run/secrets/org-repos.txt
# Optional policy exclusions (one owner/repo per line) → dark reason policy_excluded.
# GATEHOUSE_POLICY_EXCLUDED_REPOS_FILE=/run/secrets/excluded-repos.txt

# --- self-hosted PR CI runner health (D2 status tile) -------------
# Prefer the file written by deploy/runner/health-report.sh on the stack host
# (bind-mount /var/lib/aim). Or poll GitHub live with a read token.
# AIM_CI_RUNNER_STATUS_FILE=/var/lib/aim/ci-runner-status.json
# AIM_CI_RUNNER_STATUS_URL=
# AIM_CI_RUNNER_REPOS=hawikk/aim,hawikk/littlewiz
# GITHUB_TOKEN=   # or GH_TOKEN / AIM_CI_GITHUB_TOKEN — actions:read
# SYSTEM_STATUS_CI_QUEUE_WARN=3
# SYSTEM_STATUS_CI_QUEUE_HARD=10
# SYSTEM_STATUS_CI_RUNNER_STALE_SEC=300
# fleet enforce coverage pilot SLO (GET /api/enforcement/coverage +
# system-status tile enforce_coverage). Defaults: 90% install coverage,
# 0.95 honor rate after ≥5 decisions.
# ENFORCE_COVERAGE_MIN_PCT=90
# ENFORCE_HONOR_MIN_RATE=0.95
# ENFORCE_HONOR_MIN_DECISIONS=5
# Desired enforce policy_hash (defaults to deploy/enforcement/enforcement.enforce.json)
# AIM_ENFORCEMENT_DESIRED_POLICY_HASH=
# AIM_ENFORCEMENT_DESIRED_FILE=
# collector coverage SLO (≥99% enrolled endpoints healthy).
# COLLECTOR_COVERAGE_SLO_TARGET_PCT=99
# COLLECTOR_COVERAGE_SLO_WINDOW_SECONDS=86400
# SYSTEM_STATUS_DEVICE_HEALTHY_MIN_PCT=99
# SYSTEM_STATUS_ALERTS=1

# --- finding lifecycle SLA (critical ack) -----------------------
# Critical findings must leave status=new (ack or terminal) within this many
# hours of detected_at. Standing breaches publish ai_usage.finding_sla_breach
# on the same alert bus Sentinel already consumes. Compose defaults ON.
# FINDING_CRITICAL_ACK_SLA_HOURS=4
# FINDING_SLA_ALERTS=1
# FINDING_SLA_ALERT_INTERVAL_SEC=300

# --- destination health / failed delivery SLO -------------------
# Success-rate SLO over finding_deliveries (webhook/email/Slack/…).
# Breach candidates: GET /api/destination-health → #/destination-health.
# Standing breaches publish ai_usage.destination_delivery_* on the alert bus
# when DESTINATION_HEALTH_ALERTS=1 (and ALERT_BUS_URL is set).
# DESTINATION_HEALTH_WINDOW_HOURS=24
# DESTINATION_HEALTH_SUCCESS_PCT=99
# DESTINATION_HEALTH_MIN_SAMPLES=5
# DESTINATION_HEALTH_FAIL_HARD=3
# DESTINATION_HEALTH_ALERTS=1
# DESTINATION_HEALTH_ALERT_INTERVAL_SEC=300

# --- shadow-ai IdP OAuth grant inventory --------------
# Dogfood default is fixture (compose uses entra_grants.json). Live tenant:
#   SHADOW_AI_GRANT_SOURCE=entra|okta|google
# Multi-IdP pilot/production — inventory all corporate IdPs:
#   SHADOW_AI_GRANT_SOURCE=multi
#   SHADOW_AI_GRANT_SOURCES=entra,okta,google
# SHADOW_AI_GRANT_SOURCE=fixture
# SHADOW_AI_GRANT_SOURCES=
# SHADOW_AI_GRANT_FIXTURE_PATH=
# SHADOW_AI_PSEUDONYM_SECRET=   # MUST equal IDENTITY_SYNC_PSEUDONYM_SECRET
# SHADOW_AI_ENTRA_TENANT_ID=
# SHADOW_AI_ENTRA_CLIENT_ID=
# SHADOW_AI_ENTRA_CLIENT_SECRET=
# SHADOW_AI_OKTA_ORG_URL=
# SHADOW_AI_OKTA_API_TOKEN=
# SHADOW_AI_GOOGLE_CREDENTIALS_FILE=
# SHADOW_AI_GOOGLE_DELEGATED_ADMIN=

# --- detector FP rate SLO (secret/PII, live pilot) ---------------
# session_fp_rate = sessions with ≥1 false_positive secret/PII finding
#                 / sessions with ≥1 event (trailing window, default 7d).
# SLO default <0.5% of sessions. Breach → ai_usage.detector_fp_rate_breach.
# Weekly snapshots → fp_rate_snapshots (GET /api/security/fp-rate).
# DETECTOR_FP_SESSION_SLO_PCT=0.5
# DETECTOR_FP_RATE_ALERTS=1
# DETECTOR_FP_RATE_ALERT_INTERVAL_SEC=300
# DETECTOR_FP_RATE_SNAPSHOTS=1
# DETECTOR_FP_RATE_SNAPSHOT_CHECK_SEC=3600

# --- SAML 2.0 SP, alternative or parallel to OIDC ---
# Full config = entry point + IdP issuer + IdP signing cert. Partial fails closed.
# SP metadata: GET <AIM_BASE_URL>/auth/saml/metadata
# Login:       GET <AIM_BASE_URL>/auth/saml/login  (or /auth/login when SAML-only)
# ACS:         POST <AIM_BASE_URL>/auth/saml/acs
# Runbook: docs/deployment/saml-sso-runbook.md
# AIM_SAML_IDP_ENTRY_POINT=https://login.examplecorp.com/app/aim/sso/saml
# AIM_SAML_IDP_ISSUER=http://www.okta.com/exk…
# Prefer a file path for the IdP X.509 PEM (or AIM_SAML_IDP_CERT with \n escapes):
# AIM_SAML_IDP_CERT_FILE=/run/secrets/saml-idp.pem
# AIM_SAML_IDP_CERT=
# AIM_SAML_SP_ENTITY_ID=https://aim.examplecorp.com
# AIM_SAML_CALLBACK_URL=https://aim.examplecorp.com/auth/saml/acs
# AIM_SAML_GROUPS_ATTRIBUTE=groups
# AIM_SAML_EMAIL_ATTRIBUTE=email
# AIM_SAML_NAME_ATTRIBUTE=displayName

# --- prebuilt control-plane images (install-pilot pull path) ---
# Prefer GHCR images over cold `compose build`. Full guide:
#   docs/deployment/prebuilt-images.md
#   deploy/compose/images.pin.env.example
# No floating `latest` — use main-<shortsha> from release-images or digests.
# AIM_PILOT_IMAGE_MODE=prefer-pull   # prefer-pull | pull | build
# AIM_IMAGE_REGISTRY=ghcr.io/hawikk
# AIM_IMAGE_TAG=main-498275d
# Digest pins (override tag per service; preferred for enterprise pilots):
