{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimonitoring.dev/schemas/v1/security-alert.consumer.schema.json",
  "title": "security.alert/v1 (consumer profile)",
  "description": "Cross-pillar unified alert contract. A pointer to a finding in a source pillar, never a copy of it. Normative artifact of decision record D3.1.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "alert_id",
    "dedupe_key",
    "pillar",
    "producer",
    "finding_type",
    "title",
    "severity",
    "severity_id",
    "status",
    "observed_at",
    "first_seen_at",
    "last_seen_at",
    "resource",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "alert_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,64}$"
    },
    "pillar": {
      "type": "string"
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "finding_type": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "severity": {
      "type": "string"
    },
    "severity_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "status": {
      "type": "string"
    },
    "observed_at": {
      "$ref": "#/$defs/utcSecond"
    },
    "first_seen_at": {
      "$ref": "#/$defs/utcSecond"
    },
    "last_seen_at": {
      "$ref": "#/$defs/utcSecond"
    },
    "observed_count": {
      "description": "Occurrences this alert speaks for across its dedupe_key group (D3.1 \u00a73.1 / \u00a73.1.1(e), revision 5). Emit the count you actually maintain, or OMIT the field \u2014 never emit 1 to mean 'I did not count'. Optional precisely so a publisher without an aggregation table has an honest way out. Consumers: absent means unknown, not one, and you MUST NOT sum this across a dedupe_key group \u2014 each emission restates the group total, it does not add to it.",
      "type": "integer",
      "minimum": 1
    },
    "resource": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "ref",
        "display",
        "provider",
        "account_ref",
        "region"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "subject_ref": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "required": [
        "user_ref",
        "host_ref"
      ],
      "properties": {
        "user_ref": {
          "$ref": "#/$defs/pseudonym"
        },
        "host_ref": {
          "$ref": "#/$defs/pseudonym"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_uri",
        "detail_count",
        "summary"
      ],
      "properties": {
        "source_uri": {
          "description": "Pillar-scheme relative ref, resolved through the gateway at render time. Path form 'svc:/a/b' points at one record; query form 'svc:/a?k=v' points at the filtered SET a deduped alert stands for, and is REQUIRED when detail_count > 1. Rejects absolute and protocol-relative URIs, '.'-leading path segments (traversal), '%' in the path (encoded traversal), fragments, and ':' '/' '<' '>' in query values (open redirect / HTML). The gateway MUST additionally allowlist the scheme at resolve time.",
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z][a-z0-9-]{0,31}:(?:/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+(?:\\?[a-z][a-z0-9_]*=[A-Za-z0-9._~%-]*(?:&[a-z][a-z0-9_]*=[A-Za-z0-9._~%-]*){0,7})?$"
        },
        "detail_count": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "labels": {
      "type": "object",
      "maxProperties": 10,
      "propertyNames": {
        "pattern": "^[a-z0-9_.-]{1,32}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 128
      }
    },
    "remediation_hint": {
      "type": "string",
      "maxLength": 500
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "$defs": {
    "utcSecond": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "pseudonym": {
      "description": "HMAC pseudonym, lowercase hex. Plaintext identities are rejected by construction.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
