# Copy to infra/.env and fill in. NEVER commit a real .env (gitignored).

# Postgres (local dev only — use managed secrets anywhere else)
POSTGRES_USER=aimon
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aimon
# POSTGRES_PORT=5432

# Ingest API bearer tokens, comma-separated. Collectors/proxies present one
# of these on POST /v1/events.
INGEST_TOKENS=dev-token-change-me
# INGEST_PORT=3000

# OTLP receiver (AIM-105): HMAC salt the ingest service uses to derive
# host_ref from OTel service names on POST /v1/traces. App teams present one
# of the INGEST_TOKENS above. Unset = built-in dev default (fine locally;
# set a real secret anywhere shared).
# OTEL_HOST_SALT=

# Instrumented first-party services (AIM-115 dogfood pilot: the guardrail
# LLM-judge call site). One dedicated INGEST_TOKENS entry per app; the app
# presents it as an OTLP exporter header. Unset = telemetry disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://ingest:8080
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <per-app token from INGEST_TOKENS>
# AIM_OTEL_SERVICE_NAME=guardrail
# LLM provider for the judge (any OpenAI-compatible endpoint):
# AIM_LLM_BASE_URL=
# AIM_LLM_API_KEY=
# AIM_LLM_MODEL=

# Pseudonymization salt (HMAC key) used by collectors to derive host_id /
# user_ref / team_ref / repo_ref. NOT used by the ingest service itself —
# it only ever receives already-pseudonymized refs. Documented here so the
# trust model is explicit: the salt lives with collectors, outside this
# platform's storage.
# PSEUDONYMIZATION_SALT=

# Used by scripts/seed-demo-events.sh against a local stack.
# SEED_TOKEN=dev-token-change-me
# SEED_BASE_URL=http://localhost:3000
